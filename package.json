{
  "name": "@local/dsh-prompt-vault",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "提示词库：把常用提示词保存成 Markdown（本机目录或 Obsidian 库），随时从输入框插入复用。",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "prompt-library",
    "obsidian"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElioFanyu/dsh-prompt-vault.git"
  },
  "homepage": "https://github.com/ElioFanyu/dsh-prompt-vault#readme",
  "bugs": {
    "url": "https://github.com/ElioFanyu/dsh-prompt-vault/issues"
  }
}
